#!/usr/bin/env bash
# Global entry: biologis-cogitator | cogitator | init-cogitator
# Default (on a graphical session): custom GTK window hosting the TUI.
# Extra args pass through to ./run / the window.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

if [[ ! -x "$ROOT/run" && ! -f "$ROOT/run" ]]; then
  echo "error: biologis-cogitator root not found next to launcher ($ROOT)" >&2
  exit 1
fi

cd "$ROOT"

already_configured() {
  python3 - <<'PY'
import sys
sys.path.insert(0, ".")
from lib.config import is_configured
raise SystemExit(0 if is_configured() else 1)
PY
}

run_setup_if_needed() {
  if already_configured; then
    return 0
  fi
  echo "First run: opening setup to choose results and scratch folders…"
  bash "$ROOT/run" setup || {
    echo "error: setup did not complete; re-run: biologis-cogitator setup" >&2
    exit 1
  }
}

can_open_window() {
  # Force classic terminal with BIOLOGIS_NO_WINDOW=1
  [[ "${BIOLOGIS_NO_WINDOW:-}" == "1" ]] && return 1
  [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]] || return 1
  /usr/bin/python3 - <<'PY' 2>/dev/null
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Vte", "2.91")
from gi.repository import Gtk, Vte  # noqa: F401
PY
}

have_tty() {
  [[ -t 0 || -t 1 ]]
}

# When launched from a .desktop with Terminal=false and GTK/VTE is missing,
# re-exec inside a terminal emulator so the Textual TUI is visible.
reexec_in_terminal() {
  local self="$HERE/biologis-cogitator"
  export BIOLOGIS_NO_WINDOW=1
  export BIOLOGIS_IN_TERMINAL=1
  local -a cmd=("$self" "$@")
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    exec xdg-terminal-exec -- "${cmd[@]}"
  fi
  for term in kgx gnome-terminal konsole xfce4-terminal mate-terminal xterm; do
    if command -v "$term" >/dev/null 2>&1; then
      case "$term" in
        gnome-terminal|kgx)
          exec "$term" -- "${cmd[@]}"
          ;;
        konsole)
          exec "$term" -e "${cmd[@]}"
          ;;
        *)
          exec "$term" -e "${cmd[@]}"
          ;;
      esac
    fi
  done
  echo "error: no terminal emulator found to host the TUI (install gnome-terminal or set BIOLOGIS_NO_WINDOW=1 from a terminal)" >&2
  exit 1
}

open_window() {
  exec /usr/bin/python3 "$ROOT/bin/cogitator_window.py" "$@"
}

run_wizard() {
  if can_open_window; then
    open_window "$@"
  fi
  if [[ "${BIOLOGIS_IN_TERMINAL:-}" != "1" ]] && ! have_tty; then
    reexec_in_terminal wizard "$@"
  fi
  exec bash "$ROOT/run" wizard "$@"
}

# No args → setup (if needed) then app window / wizard.
if [[ $# -eq 0 ]]; then
  run_setup_if_needed
  run_wizard
fi

case "$1" in
  setup)
    exec bash "$ROOT/run" "$@"
    ;;
  window)
    shift || true
    run_setup_if_needed
    open_window "$@"
    ;;
  wizard)
    shift || true
    run_setup_if_needed
    run_wizard "$@"
    ;;
  packs|generate-system|generate|show|propose-export|layers|help|-h|--help)
    exec bash "$ROOT/run" "$@"
    ;;
  *)
    # Convenience: biologis-cogitator --pack castra-vetera → wizard with args
    run_setup_if_needed
    run_wizard "$@"
    ;;
esac
